{
  "$schema": "../gen/schemas/desktop-schema.json",
  "$comment": "Least-privilege set: each permission maps to an SPA call site. tests/capabilities/least-privilege.test.ts fails if a grant has no call site or a call site has no grant.",
  "identifier": "default",
  "description": "Capability for the main window. Least-privilege set; see `$comment`.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "$comment": "Stripe Checkout/portal (einstellungen/cloud) and customer websites (unternehmen).",
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    "process:allow-restart",
    "sql:allow-execute",
    "sql:allow-load",
    "sql:allow-select",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
