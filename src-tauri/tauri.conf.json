{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bookie",
  "version": "0.1.11",
  "identifier": "com.logscale.bookie",
  "build": {
    "removeUnusedCommands": true,
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Bookie",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 560,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar",
            "mica"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDNzY4NTU1Mjg3OTVFNkYKUldSdlhua29WWVYyTEhtU0hNZEh4UFhab2ppVkFNZ2REUlhSMC9pYUs5RzZnL0NIRXE1OGQ4L3YK",
      "endpoints": [
        "https://github.com/logscale-it/bookie/releases/latest/download/latest.json"
      ]
    },
    "sql": {
      "preload": [
        "sqlite:bookie.db"
      ]
    }
  }
}
